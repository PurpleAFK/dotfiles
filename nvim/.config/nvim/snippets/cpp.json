  "MOD Arithmetic": {
    "prefix": "mod",
    "body": [
      "const long long MOD = 1e9 + 7;",
      "",
      "long long power(long long a, long long b) {",
      "    long long res = 1;",
      "    while(b > 0) {",
      "        if(b & 1) res = (res * a) % MOD;",
      "        a = (a * a) % MOD;",
      "        b >>= 1;",
      "    }",
      "    return res;",
      "}",
      "",
      "long long modInv(long long a) {",
      "    return power(a, MOD - 2);",
      "}",
      "$0"
