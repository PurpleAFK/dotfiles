  "BFS Template": {
    "prefix": "bfs",
    "body": [
      "queue<int> q;",
      "vector<bool> visited(n + 1, false);",
      "",
      "q.push(${1:start});",
      "visited[${1:start}] = true;",
      "",
      "while(!q.empty()) {",
      "    int node = q.front();",
      "    q.pop();",
      "    ",
      "    for(int child : adj[node]) {",
      "        if(!visited[child]) {",
      "            visited[child] = true;",
      "            q.push(child);",
      "        }",
      "    }",
      "}",
      "$0"
    ],
    "description": "BFS traversal"
